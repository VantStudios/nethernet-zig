.{
    .name = .nethernet_zig,
    .version = "0.1.0",
    .fingerprint = 0x1dd985bed16ba4cb,
    .minimum_zig_version = "0.17.0",
    .description = "NetherNet (Minecraft Bedrock LAN/P2P) transport library and example server, in Zig.",

    .dependencies = .{
        .webrtc = .{
            .url = "git+https://github.com/tecton-mc/webrtc.git#a71382f91bfc0f056ff4e38726b38a1880e65000",
            .hash = "webrtc-0.2.0-I5-xj9wIBwAopmaW8eGoAMzaF7qHshpAD6SuOH2SneEm",
        },
        // Same pin `webrtc` uses, so the `ice.IceServer` this module hands the backend
        // is the very type the backend expects: Zig deduplicates by hash.
        .media_protocols = .{
            .url = "git+https://github.com/tecton-mc/media-protocols.git#0a2866e47a108f838ccf841e966d56e8b7bf7502",
            .hash = "media_protocols-0.2.0-WF_ij9ABCAD9w9xGHH2nTLj_UIz509yU2SE-Dsxz03Fq",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
